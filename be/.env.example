DATABASE_URL=postgresql+psycopg://admin:admin@localhost:5433/focusbuddy_server

# Redis & Celery (Scheduler)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Agent V2: Remote Provider (Gemma)
LLM_BASE_URL=http://llm2.dutai.site/v1
LLM_MODEL=ggml-org/gemma-4-e4b-it-GGUF:Q4_0
LLM_API_KEY=dummy

# Agent V2: Local Provider (Ollama / Qwen)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_QWEN=qwen2.5:7b

LLM_TIMEOUT=60
LLM_TEMPERATURE=0.7

# Authentication
ENVIRONMENT=development
AUTH_SECRET_KEY=change_this_to_a_secure_32_character_random_key_in_production
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOW_DEV_HEADER_AUTH=true
